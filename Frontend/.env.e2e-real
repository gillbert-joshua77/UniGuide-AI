# Playwright integration (vite --mode e2e-real).
# Real frontend talking to the real local Django API via the existing Vite
# dev-server proxy (`/api` -> http://127.0.0.1:8000). A relative base URL
# keeps requests same-origin (no CORS) and never mocks the application API.
VITE_MAINTENANCE_MODE=false
VITE_API_BASE_URL=/api/v1/
