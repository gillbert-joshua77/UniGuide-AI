# Frontend Environment Configuration
# In production, set these in the Vercel dashboard under Settings > Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1/
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Maintenance mode. Set to exactly "true" (case-insensitive, any whitespace is
# trimmed) to show the maintenance page on every route. Any other value, or a
# missing/empty value, keeps the normal application. Leave this unset or "false"
# by default. Changing this flag requires a new build/deployment.
# VITE_MAINTENANCE_MODE=false
