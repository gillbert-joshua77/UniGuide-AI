# ─── Django Core ────────────────────────────────────────────────────
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
LOG_LEVEL=INFO

# ─── Database ───────────────────────────────────────────────────────
# Render PostgreSQL: set DATABASE_URL (provided automatically by Render)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
#
# Local MySQL fallback (used when DATABASE_URL is not set):
DB_ENGINE=django.db.backends.mysql
DB_NAME=uniguide_ai
DB_USER=root
DB_PASSWORD=1234
DB_HOST=127.0.0.1
DB_PORT=3307

# ─── CORS & CSRF ───────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ─── Frontend URL ──────────────────────────────────────────────────
# Used for password reset links and OAuth redirects
FRONTEND_URL=http://localhost:5173

# ─── Email (Gmail SMTP) ────────────────────────────────────────────
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# ─── Google OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
SOCIAL_AUTH_PASSWORD=your_social_auth_password

# ─── API Keys ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
NEWS_API_KEY=your_news_api_key_here
